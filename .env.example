# ==========================================
# Phraiz Solo Rebuild - Phase 1 Environment
# ==========================================

# --- Database & Cache ---
MYSQL_ROOT_PASSWORD=phraiz_root_pw
MYSQL_DATABASE=phraiz
MYSQL_USER=phraiz_user
MYSQL_PASSWORD=phraiz_pw
REDIS_PORT=6379

# --- Zotero Translation Server ---
ZOTERO_PORT=1969

# --- LLM Gateway (Option A: Local LiteLLM Proxy) ---
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-phraiz-local-master-key

# LiteLLM이 호출할 실제 프로바이더 키 (사용할 프로바이더만 입력)
ANTHROPIC_API_KEY=sk-ant-replace-me
GEMINI_API_KEY=AIza-replace-me
OPENAI_API_KEY=sk-proj-replace-me

# --- Spring Boot -> LLM Gateway 연결 설정 ---
# LiteLLM 사용 시: http://localhost:4000/v1
# OpenRouter 직접 사용 시: https://openrouter.ai/api/v1
LLM_GATEWAY_BASE_URL=http://localhost:4000/v1
LLM_GATEWAY_API_KEY=sk-phraiz-local-master-key

# --- 기능별 모델 Alias (코드 수정 없이 모델 교체) ---
LLM_MODEL_PARAPHRASE=paraphrase-default
LLM_MODEL_PARAPHRASE_FAST=paraphrase-fast
LLM_MODEL_SUMMARY=summary-pdf
LLM_MODEL_CITE_FALLBACK=cite-fallback
